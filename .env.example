# ==============================
# APLICACION
# ==============================

APP_NAME=LocalDoc AI
APP_ENV=development
LOG_LEVEL=INFO

# ==============================
# OLLAMA - MODELO LOCAL
# ==============================

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TEMPERATURE=0
OLLAMA_TIMEOUT=120
MAX_AGENT_STEPS=5
MAX_CONVERSATION_TURNS=6

# ==============================
# BASE DE DATOS POSTGRESQL
# ==============================

DATABASE_URL=postgresql://localdoc:CAMBIAR_PASSWORD@localhost:5432/localdoc

# ==============================
# DOCUMENTOS
# ==============================

DOCUMENTS_DIR=./data
INBOX_DIR=./data/inbox
PROCESSED_DIR=./data/processed
SAMPLES_DIR=./data/samples
REPORTS_DIR=./reports

MAX_FILE_SIZE_MB=20

# ==============================
# OCR
# ==============================

OCR_LANG=spa
OCR_DPI=200

# ==============================
# AGENTE
# ==============================

MAX_AGENT_STEPS=5

# ==============================
# TELEGRAM
# ==============================

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
MAX_FILE_SIZE_MB=20
