# ==============================
# APLICACION
# ==============================

APP_NAME=LocalDoc AI
APP_ENV=development
LOG_LEVEL=INFO

# ==============================
# OLLAMA - MODELO LOCAL
# ==============================

OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_VISION_MODEL=qwen2.5vl:7b
OLLAMA_TEMPERATURE=0
OLLAMA_TIMEOUT=120
# El prompt, las herramientas y los resultados MCP superan los 4096 tokens
# que Ollama usa por defecto. 16384 evita que se descarte contexto.
OLLAMA_NUM_CTX=16384
# Límite de tokens de salida por respuesta del agente.
OLLAMA_NUM_PREDICT=1024
MAX_TOOL_RESULT_CHARS=30000

# ==============================
# BASE DE DATOS POSTGRESQL
# ==============================

DATABASE_URL=postgresql+psycopg://localdoc:CAMBIAR_PASSWORD@localhost:5432/localdoc

# ==============================
# DOCUMENTOS
# ==============================

DOCUMENTS_DIR=./data
INBOX_DIR=./data/inbox
SAMPLES_DIR=./data/samples
REPORTS_DIR=./reports

MAX_FILE_SIZE_MB=20

# ==============================
# OCR
# ==============================

OCR_LANG=spa
OCR_DPI=300

# ==============================
# AGENTE
# ==============================

MAX_AGENT_STEPS=5
MAX_CONVERSATION_TURNS=6

# ==============================
# TELEGRAM
# ==============================

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
